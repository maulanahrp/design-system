{
  "$description": "Design system sekunder MaulanaHRP: gaya Neubrutalism. Menimpa token semantik & bentuk dari tokens.json di bawah selector [data-style=\"neubrutalism\"]. Jalankan `npm test` setelah mengubah.",
  "color": {
    "neo": {
      "ink":       { "$value": "#0C1A38", "$description": "Tinta: border, bayangan, teks. Sama dengan navy-950." },
      "paper":     { "$value": "#F3F8FB", "$description": "Latar halaman (putih dingin)." },
      "white":     { "$value": "#FFFFFF" },
      "navy":      { "$value": "#1D3668", "$description": "Navy brand." },
      "cyan":      { "$value": "#68C0D2", "$description": "Cyan brand: fill utama button & blok." },
      "sky":       { "$value": "#A8E1EB", "$description": "Cyan muda: blok sekunder, tab aktif." },
      "blue":      { "$value": "#3B6CA7", "$description": "Wave blue: blok dekoratif, teks putih." },
      "sun":       { "$value": "#FFC93C", "$description": "Pop kuning: CTA aksen, highlight, sticker." },
      "sun-soft":  { "$value": "#FFF0C2" },
      "mint":      { "$value": "#7FE0AE", "$description": "Sukses (fill)." },
      "mint-soft": { "$value": "#D4F7E3" },
      "coral":     { "$value": "#FF8A7A", "$description": "Bahaya (fill)." },
      "coral-soft":{ "$value": "#FFDDD8" },
      "ink-2":     { "$value": "#13244A", "$description": "Permukaan di dark mode." },
      "ink-3":     { "$value": "#1E3366", "$description": "Permukaan terangkat di dark mode." }
    }
  },
  "font": {
    "heading-weight": { "$value": "800" },
    "label": { "$value": "'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace", "$description": "Label, badge, overline, tombol kecil." }
  },
  "shape": {
    "light": {
      "border-width":        { "$value": "2px" },
      "border-color":        { "$value": "{color.neo.ink}" },
      "control-radius":      { "$value": "6px" },
      "card-radius":         { "$value": "10px" },
      "control-height":      { "$value": "2.75rem" },
      "card-shadow":         { "$value": "6px 6px 0 0 {color.neo.ink}" },
      "card-shadow-hover":   { "$value": "9px 9px 0 0 {color.neo.ink}" },
      "btn-shadow":          { "$value": "4px 4px 0 0 {color.neo.ink}" },
      "btn-shadow-hover":    { "$value": "6px 6px 0 0 {color.neo.ink}" },
      "btn-shadow-active":   { "$value": "0 0 0 0 {color.neo.ink}" },
      "btn-lift":            { "$value": "2px" },
      "btn-press":           { "$value": "4px" },
      "btn-weight":          { "$value": "700" },
      "heading-weight":      { "$value": "800" },
      "overlay":             { "$value": "rgba(12, 26, 56, 0.6)" },
      "focus-ring":          { "$value": "0 0 0 3px {color.neo.paper}, 0 0 0 6px {color.neo.ink}" },
      "shadow-sm":           { "$value": "2px 2px 0 0 {color.neo.ink}" },
      "shadow-md":           { "$value": "4px 4px 0 0 {color.neo.ink}" },
      "shadow-lg":           { "$value": "8px 8px 0 0 {color.neo.ink}" }
    },
    "dark": {
      "border-color":        { "$value": "{color.neo.paper}" },
      "card-shadow":         { "$value": "6px 6px 0 0 {color.neo.cyan}" },
      "card-shadow-hover":   { "$value": "9px 9px 0 0 {color.neo.cyan}" },
      "btn-shadow":          { "$value": "4px 4px 0 0 {color.neo.paper}" },
      "btn-shadow-hover":    { "$value": "6px 6px 0 0 {color.neo.paper}" },
      "btn-shadow-active":   { "$value": "0 0 0 0 {color.neo.paper}" },
      "overlay":             { "$value": "rgba(0, 0, 0, 0.7)" },
      "focus-ring":          { "$value": "0 0 0 3px {color.neo.ink}, 0 0 0 6px {color.neo.sun}" },
      "shadow-sm":           { "$value": "2px 2px 0 0 {color.neo.cyan}" },
      "shadow-md":           { "$value": "4px 4px 0 0 {color.neo.cyan}" },
      "shadow-lg":           { "$value": "8px 8px 0 0 {color.neo.cyan}" }
    }
  },
  "semantic": {
    "light": {
      "bg":              { "$value": "{color.neo.paper}" },
      "bg-subtle":       { "$value": "#E3F1F6" },
      "bg-muted":        { "$value": "#D2EAF1" },
      "surface":         { "$value": "{color.neo.white}" },
      "surface-raised":  { "$value": "{color.neo.white}" },
      "surface-inverse": { "$value": "{color.neo.ink}" },
      "border":          { "$value": "{color.neo.ink}" },
      "border-strong":   { "$value": "{color.neo.ink}" },
      "text":            { "$value": "{color.neo.ink}" },
      "text-muted":      { "$value": "#2E3B55" },
      "text-subtle":     { "$value": "#4A5872" },
      "text-inverse":    { "$value": "{color.neo.paper}" },
      "heading":         { "$value": "{color.neo.ink}" },
      "primary":         { "$value": "{color.neo.navy}" },
      "primary-hover":   { "$value": "{color.neo.ink}" },
      "primary-active":  { "$value": "{color.neo.ink}" },
      "primary-subtle":  { "$value": "{color.neo.sky}" },
      "on-primary":      { "$value": "{color.neo.white}" },
      "accent":          { "$value": "{color.neo.sun}" },
      "accent-strong":   { "$value": "#7A4E00" },
      "accent-subtle":   { "$value": "{color.neo.sun-soft}" },
      "on-accent":       { "$value": "{color.neo.ink}" },
      "link":            { "$value": "{color.neo.navy}" },
      "success":         { "$value": "#0E5C36" },
      "success-subtle":  { "$value": "{color.neo.mint-soft}" },
      "warning":         { "$value": "#6E4600" },
      "warning-subtle":  { "$value": "{color.neo.sun-soft}" },
      "danger":          { "$value": "#9C1F17" },
      "danger-subtle":   { "$value": "{color.neo.coral-soft}" },
      "info":            { "$value": "{color.neo.navy}" },
      "info-subtle":     { "$value": "#D6F0F5" },
      "neo-fill":        { "$value": "{color.neo.cyan}" },
      "neo-fill-hover":  { "$value": "{color.neo.sky}" },
      "on-neo-fill":     { "$value": "{color.neo.ink}" },
      "neo-ink":         { "$value": "{color.neo.ink}" }
    },
    "dark": {
      "bg":              { "$value": "{color.neo.ink}" },
      "bg-subtle":       { "$value": "{color.neo.ink-2}" },
      "bg-muted":        { "$value": "{color.neo.ink-3}" },
      "surface":         { "$value": "{color.neo.ink-2}" },
      "surface-raised":  { "$value": "{color.neo.ink-3}" },
      "surface-inverse": { "$value": "{color.neo.paper}" },
      "border":          { "$value": "{color.neo.paper}" },
      "border-strong":   { "$value": "{color.neo.paper}" },
      "text":            { "$value": "{color.neo.paper}" },
      "text-muted":      { "$value": "#C9D6E6" },
      "text-subtle":     { "$value": "#A9B8CC" },
      "text-inverse":    { "$value": "{color.neo.ink}" },
      "heading":         { "$value": "{color.neo.white}" },
      "primary":         { "$value": "{color.neo.sky}" },
      "primary-hover":   { "$value": "{color.neo.white}" },
      "primary-active":  { "$value": "{color.neo.white}" },
      "primary-subtle":  { "$value": "{color.neo.ink-3}" },
      "on-primary":      { "$value": "{color.neo.ink}" },
      "accent":          { "$value": "{color.neo.sun}" },
      "accent-strong":   { "$value": "{color.neo.sun}" },
      "accent-subtle":   { "$value": "#3A3214" },
      "on-accent":       { "$value": "{color.neo.ink}" },
      "link":            { "$value": "{color.neo.sky}" },
      "success":         { "$value": "{color.neo.mint}" },
      "success-subtle":  { "$value": "#103A2A" },
      "warning":         { "$value": "{color.neo.sun}" },
      "warning-subtle":  { "$value": "#3A3214" },
      "danger":          { "$value": "{color.neo.coral}" },
      "danger-subtle":   { "$value": "#45201F" },
      "info":            { "$value": "{color.neo.sky}" },
      "info-subtle":     { "$value": "{color.neo.ink-3}" },
      "neo-fill":        { "$value": "{color.neo.cyan}" },
      "neo-fill-hover":  { "$value": "{color.neo.sky}" },
      "on-neo-fill":     { "$value": "{color.neo.ink}" },
      "neo-ink":         { "$value": "{color.neo.paper}" }
    }
  }
}
