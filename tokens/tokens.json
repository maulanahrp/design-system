{
  "$description": "Design tokens MaulanaHRP Tech Solution — sumber tunggal. Jalankan `node scripts/build-tokens.mjs` setelah mengubah file ini.",
  "color": {
    "navy": {
      "$description": "Warna brand utama. 800 = navy logo (cincin & wordmark).",
      "50":  { "$value": "#EEF3FA" },
      "100": { "$value": "#D9E3F2" },
      "200": { "$value": "#B3C6E4" },
      "300": { "$value": "#84A2D0" },
      "400": { "$value": "#5A7FBA" },
      "500": { "$value": "#3B6CA7" },
      "600": { "$value": "#2E5C9C" },
      "700": { "$value": "#274B91" },
      "800": { "$value": "#1C366B" },
      "900": { "$value": "#142852" },
      "950": { "$value": "#0C1A38" }
    },
    "cyan": {
      "$description": "Warna aksen. 400 = cyan ujung gelombang logo.",
      "50":  { "$value": "#EDF9FB" },
      "100": { "$value": "#D2F0F5" },
      "200": { "$value": "#A8E1EB" },
      "300": { "$value": "#7FD0DF" },
      "400": { "$value": "#68C0D2" },
      "500": { "$value": "#45A9BF" },
      "600": { "$value": "#2F8AA0" },
      "700": { "$value": "#276F82" },
      "800": { "$value": "#235A69" },
      "900": { "$value": "#1F4A57" }
    },
    "neutral": {
      "$description": "Abu-abu bernuansa biru (slate) untuk teks, border, latar.",
      "0":   { "$value": "#FFFFFF" },
      "50":  { "$value": "#F6F8FB" },
      "100": { "$value": "#EDF1F6" },
      "200": { "$value": "#DCE3EC" },
      "300": { "$value": "#C2CCD9" },
      "400": { "$value": "#95A3B8" },
      "500": { "$value": "#627189" },
      "600": { "$value": "#4F5D75" },
      "700": { "$value": "#3A465B" },
      "800": { "$value": "#262F40" },
      "900": { "$value": "#171D2A" },
      "950": { "$value": "#0D111A" }
    },
    "success": { "50": { "$value": "#E8F6EF" }, "400": { "$value": "#4CC88E" }, "500": { "$value": "#2BA36B" }, "700": { "$value": "#1B7A4D" } },
    "warning": { "50": { "$value": "#FFF4E0" }, "500": { "$value": "#E59A1A" }, "700": { "$value": "#9A5B00" } },
    "danger":  { "50": { "$value": "#FDECEB" }, "500": { "$value": "#E0483F" }, "700": { "$value": "#B3302A" } },
    "gradient": {
      "brand": { "$value": "linear-gradient(135deg, #68C0D2 0%, #3B6CA7 55%, #1C366B 100%)", "$description": "Gradasi gelombang logo. Untuk hero, cover deck, aksen — bukan untuk latar teks panjang." },
      "wave":  { "$value": "linear-gradient(90deg, #68C0D2 0%, #3B6CA7 100%)" }
    }
  },
  "font": {
    "family": {
      "heading": { "$value": "'Montserrat', 'Segoe UI', system-ui, -apple-system, sans-serif" },
      "body":    { "$value": "'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif" },
      "mono":    { "$value": "'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace" }
    },
    "weight": {
      "regular":  { "$value": "400" },
      "medium":   { "$value": "500" },
      "semibold": { "$value": "600" },
      "bold":     { "$value": "700" }
    },
    "size": {
      "$description": "Skala 1.25 (major third), basis 16px.",
      "xs":   { "$value": "0.75rem" },
      "sm":   { "$value": "0.875rem" },
      "md":   { "$value": "1rem" },
      "lg":   { "$value": "1.125rem" },
      "xl":   { "$value": "1.25rem" },
      "2xl":  { "$value": "1.5rem" },
      "3xl":  { "$value": "1.875rem" },
      "4xl":  { "$value": "2.375rem" },
      "5xl":  { "$value": "3rem" },
      "6xl":  { "$value": "3.75rem" }
    },
    "line-height": {
      "tight":   { "$value": "1.15" },
      "snug":    { "$value": "1.3" },
      "normal":  { "$value": "1.55" },
      "relaxed": { "$value": "1.7" }
    },
    "letter-spacing": {
      "tight":  { "$value": "-0.02em" },
      "normal": { "$value": "0" },
      "wide":   { "$value": "0.06em" }
    }
  },
  "space": {
    "$description": "Grid 4px.",
    "0":  { "$value": "0" },
    "1":  { "$value": "0.25rem" },
    "2":  { "$value": "0.5rem" },
    "3":  { "$value": "0.75rem" },
    "4":  { "$value": "1rem" },
    "5":  { "$value": "1.25rem" },
    "6":  { "$value": "1.5rem" },
    "8":  { "$value": "2rem" },
    "10": { "$value": "2.5rem" },
    "12": { "$value": "3rem" },
    "16": { "$value": "4rem" },
    "20": { "$value": "5rem" },
    "24": { "$value": "6rem" }
  },
  "radius": {
    "none": { "$value": "0" },
    "sm":   { "$value": "4px" },
    "md":   { "$value": "8px" },
    "lg":   { "$value": "12px" },
    "xl":   { "$value": "20px" },
    "full": { "$value": "9999px" }
  },
  "shadow": {
    "sm": { "$value": "0 1px 2px rgba(12, 26, 56, 0.06), 0 1px 3px rgba(12, 26, 56, 0.08)" },
    "md": { "$value": "0 4px 12px rgba(12, 26, 56, 0.08), 0 2px 4px rgba(12, 26, 56, 0.06)" },
    "lg": { "$value": "0 12px 32px rgba(12, 26, 56, 0.12), 0 4px 8px rgba(12, 26, 56, 0.06)" },
    "focus": { "$value": "0 0 0 3px rgba(104, 192, 210, 0.55)" }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "320ms" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)" },
      "out":      { "$value": "cubic-bezier(0, 0, 0.2, 1)" }
    }
  },
  "breakpoint": {
    "sm": { "$value": "640px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px" }
  },
  "z": {
    "dropdown": { "$value": "1000" },
    "sticky":   { "$value": "1100" },
    "modal":    { "$value": "1300" },
    "toast":    { "$value": "1400" }
  },
  "semantic": {
    "$description": "Token peran (role). Komponen HANYA memakai token ini, bukan skala mentah. Nilai berupa referensi {grup.skala}.",
    "light": {
      "bg":              { "$value": "{color.neutral.0}" },
      "bg-subtle":       { "$value": "{color.neutral.50}" },
      "bg-muted":        { "$value": "{color.neutral.100}" },
      "surface":         { "$value": "{color.neutral.0}" },
      "surface-raised":  { "$value": "{color.neutral.0}" },
      "surface-inverse": { "$value": "{color.navy.800}" },
      "border":          { "$value": "{color.neutral.200}" },
      "border-strong":   { "$value": "{color.neutral.300}" },
      "text":            { "$value": "{color.neutral.900}" },
      "text-muted":      { "$value": "{color.neutral.600}" },
      "text-subtle":     { "$value": "{color.neutral.500}" },
      "text-inverse":    { "$value": "{color.neutral.0}" },
      "heading":         { "$value": "{color.navy.800}" },
      "primary":         { "$value": "{color.navy.700}" },
      "primary-hover":   { "$value": "{color.navy.800}" },
      "primary-active":  { "$value": "{color.navy.900}" },
      "primary-subtle":  { "$value": "{color.navy.50}" },
      "on-primary":      { "$value": "{color.neutral.0}" },
      "accent":          { "$value": "{color.cyan.400}" },
      "accent-strong":   { "$value": "{color.cyan.700}" },
      "accent-subtle":   { "$value": "{color.cyan.50}" },
      "on-accent":       { "$value": "{color.navy.950}" },
      "link":            { "$value": "{color.navy.600}" },
      "success":         { "$value": "{color.success.700}" },
      "success-subtle":  { "$value": "{color.success.50}" },
      "warning":         { "$value": "{color.warning.700}" },
      "warning-subtle":  { "$value": "{color.warning.50}" },
      "danger":          { "$value": "{color.danger.700}" },
      "danger-subtle":   { "$value": "{color.danger.50}" },
      "info":            { "$value": "{color.navy.600}" },
      "info-subtle":     { "$value": "{color.navy.50}" }
    },
    "dark": {
      "bg":              { "$value": "{color.neutral.950}" },
      "bg-subtle":       { "$value": "{color.neutral.900}" },
      "bg-muted":        { "$value": "{color.neutral.800}" },
      "surface":         { "$value": "{color.neutral.900}" },
      "surface-raised":  { "$value": "{color.neutral.800}" },
      "surface-inverse": { "$value": "{color.neutral.50}" },
      "border":          { "$value": "{color.neutral.700}" },
      "border-strong":   { "$value": "{color.neutral.600}" },
      "text":            { "$value": "{color.neutral.50}" },
      "text-muted":      { "$value": "{color.neutral.300}" },
      "text-subtle":     { "$value": "{color.neutral.400}" },
      "text-inverse":    { "$value": "{color.neutral.950}" },
      "heading":         { "$value": "{color.neutral.0}" },
      "primary":         { "$value": "{color.navy.300}" },
      "primary-hover":   { "$value": "{color.navy.200}" },
      "primary-active":  { "$value": "{color.navy.100}" },
      "primary-subtle":  { "$value": "{color.navy.950}" },
      "on-primary":      { "$value": "{color.navy.950}" },
      "accent":          { "$value": "{color.cyan.400}" },
      "accent-strong":   { "$value": "{color.cyan.300}" },
      "accent-subtle":   { "$value": "{color.cyan.900}" },
      "on-accent":       { "$value": "{color.navy.950}" },
      "link":            { "$value": "{color.cyan.300}" },
      "success":         { "$value": "{color.success.400}" },
      "success-subtle":  { "$value": "#12301F" },
      "warning":         { "$value": "{color.warning.500}" },
      "warning-subtle":  { "$value": "#33240A" },
      "danger":          { "$value": "#F07068" },
      "danger-subtle":   { "$value": "#3A1614" },
      "info":            { "$value": "{color.navy.300}" },
      "info-subtle":     { "$value": "{color.navy.950}" }
    }
  }
}
